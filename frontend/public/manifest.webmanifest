{
  "name": "LifeOS — Your personal workspace",
  "short_name": "LifeOS",
  "description": "Plan your time, focus on your priorities, and build lasting habits.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f8fc",
  "theme_color": "#4446c4",
  "dir": "auto",
  "lang": "en",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Quick add a task", "short_name": "Add task", "url": "/?add=task", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Start focus", "short_name": "Focus", "url": "/focus", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's calendar", "short_name": "Calendar", "url": "/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Plan my day", "short_name": "Plan", "url": "/planning", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
